# =============================================================================
#  Ultimate Hardening — settings template
#
#  Every value below is the built-in default (or empty), so this file changes
#  nothing until you edit it. Copy it, edit the copy, and load it before a run:
#
#      cp examples/.env.example hardening.env      # *.env is git-ignored
#      set -a; . ./hardening.env; set +a
#      sudo -E ./src/free/ultimate_hardening.sh
#
#  or pass a single setting directly:
#
#      sudo UH_USB_STORAGE_BLACKLIST=false ./src/free/ultimate_hardening.sh
#
#  Never put passwords, tokens or keys in this template — the repository's
#  hooks refuse a template with a secret-looking value filled in.
# =============================================================================

# --- Module 15: boot security ------------------------------------------------
# true  = block every USB storage device (usb-storage blacklist)
# false = leave USB storage usable, for hosts that need USB disks
UH_USB_STORAGE_BLACKLIST=true

# --- Backups -----------------------------------------------------------------
# Where per-run backups are kept, and how many days they are kept for.
UH_BACKUP_ROOT=/root
UH_BACKUP_RETENTION_DAYS=90

# --- Module 21: remote syslog ------------------------------------------------
# Collector host or IP. Empty = asked interactively; skipped in --auto-mode.
UH_SYSLOG_SERVER=
# udp, tcp or tls. Setting a CA file below implies tls.
UH_SYSLOG_PROTO=udp
# Empty = 514 (udp/tcp) or 6514 (tls).
UH_SYSLOG_PORT=
# CA certificate that signed the collector's certificate (tls only).
UH_SYSLOG_TLS_CA=

# --- Menu --------------------------------------------------------------------
# 1 = show the SUID module's real state in the menu (a full filesystem scan,
#     roughly 10+ seconds each time the menu redraws).
UH_SUID_SCAN=0
