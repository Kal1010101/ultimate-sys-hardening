#!/bin/bash
# =============================================================================
#  pre-commit — refuse to publish commercial source from the public repo
#
#  This repository's remote is the PUBLIC github.com/Kal1010101/ultimate-sys-
#  hardening and its LICENSE is MIT: anything committed here is published under
#  an MIT grant, irreversibly. The Pro and Enterprise tiers are commercial.
#
#  .gitignore already lists the obvious paths, but it did not close the hole
#  that actually fired: the commercial checkout symlinks its lib/ and tests/
#  into THIS repo, a commercial test file was written through that symlink into
#  tests/ — which is tracked, not ignored — and it reached the public repo
#  before being removed. .gitignore is also bypassed by `git add -f`.
#
#  So this checks CONTENT as well as paths. Path rules can only anticipate the
#  directories that exist today; the next src/shared/ will not be in the list.
#
#  Install:  ./scripts/hooks/install.sh
#  Override: git commit --no-verify   (deliberate, and it says so below)
# =============================================================================
set -uo pipefail

RED=$'\033[0;31m'; YEL=$'\033[1;33m'; CYN=$'\033[0;36m'; NC=$'\033[0m'

# Paths that are commercial by location.
PATH_RULES='^(src/pro/|src/enterprise/|src/shared/|LICENSE-PRO\.md$|PRICING\.md$)'

# Identifiers that appear in commercial source and nowhere in this repo are the
# CONTENT heuristic. The LIST itself is paid intel — the paid function names and
# tier constants — so it is NOT hard-coded here, where this public MIT repo would
# publish it in cleartext. It is loaded at run time from a marker file that lives
# in the private commercial repo (or a gitignored local fallback), resolved in
# order:
#   $UH_PUBLICATION_MARKERS                         explicit path override
#   <commercial repo>/ci/publication-markers.txt    the private list (default)
#   <free repo>/scripts/hooks/publication-markers.local   gitignored fallback
# One marker per line; blank lines and #-comments are ignored; each is matched
# as a literal substring. New paid feature names are added to that file as part
# of the feature workflow, never here.
#
# When no marker file is found — CI, a contributor's clone — the content
# heuristic is simply inert. That is the same gap the exact blob-hash check below
# has without the commercial repo, and the hash check is the real guard anyway;
# the content list only ever caught bash tier source. Deliberately never markers,
# because they occur legitimately here and blocking them trains people onto
# --no-verify: "LICENSE-PRO" (the free LICENSE points at it) and the bare tier
# paths (test_module_count.sh / test_module_isolation.sh iterate the tiers by
# path and skip the absent ones).
#
# The guard's own two files are exempt from the CONTENT scan — they name the
# resolution mechanism but hold no markers themselves, yet a future edit could
# reintroduce one, and a guard that blocks its own commit just teaches bypass.
# The path rules above still apply to them.
SELF_PATHS='^(scripts/hooks/pre-commit|tests/cases/test_publication_guard\.sh)$'

# Resolve and load the marker file. Kept as a function so the test can reuse the
# exact same resolution order rather than second-guessing it.
_uh_markers_file() {
    local repo_root commercial
    if [[ -n "${UH_PUBLICATION_MARKERS:-}" && -r "$UH_PUBLICATION_MARKERS" ]]; then
        printf '%s\n' "$UH_PUBLICATION_MARKERS"; return 0
    fi
    commercial="${UH_COMMERCIAL_REPO:-$(cd "$(git rev-parse --show-toplevel 2>/dev/null)/.." 2>/dev/null && pwd)/ultimate-hardening-commercial}"
    if [[ -r "$commercial/ci/publication-markers.txt" ]]; then
        printf '%s\n' "$commercial/ci/publication-markers.txt"; return 0
    fi
    repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"
    if [[ -n "$repo_root" && -r "$repo_root/scripts/hooks/publication-markers.local" ]]; then
        printf '%s\n' "$repo_root/scripts/hooks/publication-markers.local"; return 0
    fi
    return 1
}

CONTENT_MARKERS=()
if markers_file="$(_uh_markers_file)"; then
    while IFS= read -r line; do
        line="${line%%#*}"                    # strip trailing comment
        line="${line#"${line%%[![:space:]]*}"}"; line="${line%"${line##*[![:space:]]}"}"
        [[ -n "$line" ]] && CONTENT_MARKERS+=("$line")
    done < "$markers_file"
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null)
[[ -n "$staged" ]] || exit 0

# Env files with credentials never enter the repository (scripts/hooks/env-guard.sh;
# pre-push enforces the same on push).
# shellcheck source=scripts/hooks/env-guard.sh
source "$(dirname "${BASH_SOURCE[0]}")/env-guard.sh" 2>/dev/null \
    || { echo "pre-commit: scripts/hooks/env-guard.sh is missing — refusing to continue" >&2; exit 1; }
env_refused=""
while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    reason=$(env_guard_check "$f" "$(git show ":$f" 2>/dev/null)") || env_refused+="    $reason"$'\n'
done <<< "$staged"
if [[ -n "$env_refused" ]]; then
    echo "${RED}pre-commit: refusing env files:${NC}" >&2
    printf '%s' "$env_refused" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Exact-content check against the commercial repo.
#
# The identifier list (loaded above from the private marker file) is a heuristic
# and only ever caught bash tier source. Measured against the real commercial
# repo, staging each of its files under an innocent name: 21 of 27 got through —
# the Python dashboard modules,
# the HTML/CSS/JS, the examples, ci.yml, the tier READMEs, PRICING.md. A guard
# that catches 6 of 27 is worse than none, because it feels like protection.
#
# This compares git blob hashes instead, so it is exact and file-type blind.
# It catches the realistic leak — a file written verbatim through the symlinked
# lib/ or tests/ — regardless of what it is called or where it is staged.
#
# lib/ and tests/ inside the commercial repo are SYMLINKS back into this one.
# They must be excluded, or this would hash this repo's own files and block
# every commit. (`find` does not descend symlinked directories without -L, but
# the exclusions are explicit so a future -L cannot quietly break it.)
#
# If the commercial repo is not on this machine — CI, a contributor's clone —
# this check simply does not run, and the identifier list is all that remains.
# That is a real gap, not a covered one.
COMMERCIAL="${UH_COMMERCIAL_REPO:-$(cd "$(git rev-parse --show-toplevel)/.." 2>/dev/null && pwd)/ultimate-hardening-commercial}"
COMMERCIAL_HASHES=""
if [[ -d "$COMMERCIAL" ]]; then
    COMMERCIAL_HASHES=$(find "$COMMERCIAL" -type f \
        -not -path '*/.git/*' -not -path '*/_gitjunk/*' \
        -not -path "$COMMERCIAL/lib/*" -not -path "$COMMERCIAL/tests/*" \
        -print0 2>/dev/null | xargs -0 -r git hash-object 2>/dev/null)

    # Subtract the blobs THIS repo already tracks. A blob present in both repos
    # is free-tier content by definition, and refusing it would be refusing
    # ordinary work.
    #
    # This is not hypothetical tidiness. If the commercial repo is ever changed
    # from "paid tiers only, sharing lib/ by symlink" to "a whole self-contained
    # copy of free + paid" — a structure worth considering, since it removes the
    # symlink leak path entirely — then every free-tier file exists verbatim in
    # both repos. Tested against a simulated vendored layout: without this
    # subtraction the hook refused src/free/ultimate_hardening.sh and
    # README.md. The hook has to survive that restructure, not block it.
    if [[ -n "$COMMERCIAL_HASHES" ]]; then
        own=$(git ls-tree -r HEAD 2>/dev/null | awk '{print $3}')
        if [[ -n "$own" ]]; then
            COMMERCIAL_HASHES=$(grep -vxF -f <(printf '%s\n' "$own") \
                                <<< "$COMMERCIAL_HASHES" || true)
        fi
    fi
fi

# Binary paths, asked of git rather than guessed from the bytes. numstat prints
# "-\t-" for a binary blob.
#
# The previous attempt tested `case "$content" in *$'\0'*)`, which silently
# disabled the entire content check: bash cannot hold a NUL in a string, so
# $'\0' expands to nothing and the pattern degenerates to `**`, matching every
# file. The path rules still fired, so the hook looked like it worked.
BINARY=$(git diff --cached --numstat --diff-filter=ACMR 2>/dev/null \
         | awk -F'\t' '$1 == "-" && $2 == "-" { print $3 }')

declare -a HITS=()

while IFS= read -r f; do
    [[ -n "$f" ]] || continue

    if [[ "$f" =~ $PATH_RULES ]]; then
        HITS+=("$f — commercial path")
        continue
    fi

    if [[ "$f" =~ $SELF_PATHS ]]; then
        continue
    fi

    # Exact match against a file that lives in the commercial repo.
    if [[ -n "$COMMERCIAL_HASHES" ]]; then
        blob=$(git rev-parse ":$f" 2>/dev/null)
        if [[ -n "$blob" ]] && grep -qxF -- "$blob" <<< "$COMMERCIAL_HASHES"; then
            HITS+=("$f — byte-identical to a file in the commercial repo")
            continue
        fi
    fi

    if [[ -n "$BINARY" ]] && grep -qxF -- "$f" <<< "$BINARY"; then
        continue
    fi

    # No marker file on this machine — the content heuristic is inert here, as
    # documented above. Skip the per-marker scan rather than tripping set -u on
    # an empty array under old bash.
    (( ${#CONTENT_MARKERS[@]} )) || continue

    # The STAGED blob, not the working copy: what is about to be committed is
    # the index's version, and the two can differ.
    content=$(git show ":$f" 2>/dev/null) || continue

    for m in "${CONTENT_MARKERS[@]}"; do
        if grep -qF -- "$m" <<< "$content"; then
            HITS+=("$f — contains '$m'")
            break
        fi
    done
done <<< "$staged"

if (( ${#HITS[@]} == 0 )); then
    exit 0
fi

{
    echo ""
    echo "${RED}Commit refused: this looks like commercial source, and this repo is public.${NC}"
    echo ""
    for h in "${HITS[@]}"; do echo "    ${YEL}$h${NC}"; done
    echo ""
    echo "  This repository publishes under MIT. Pro and Enterprise belong in the"
    echo "  private commercial repository."
    echo ""
    echo "  If a commercial file reached this working tree through the symlinked"
    echo "  lib/ or tests/, move it into the commercial repo's own src/ instead —"
    echo "  those two directories ARE this repo, so writing there publishes."
    echo ""
    echo "  ${CYN}Genuinely a false positive?${NC} Commit with --no-verify, then open"
    echo "  scripts/hooks/pre-commit and remove the marker that misfired, so the"
    echo "  next person is not trained to bypass the hook."
    echo ""
} >&2
exit 1
